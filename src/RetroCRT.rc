// Paths are relative to the project root, which build.bat / CMake pass as an include directory.
#include <windows.h>
#include "resource.h"

#ifdef RETROCRT_UIACCESS
// uiAccess="true": Windows only starts it when signed with a trusted certificate and placed in
// Program Files (see install-uiaccess.ps1).
1 24 "src/RetroCRT.uiaccess.manifest"
#else
1 24 "src/RetroCRT.manifest"
#endif

IDR_CRT_HLSL RCDATA "shaders/crt.hlsl"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEOS 0x40004L
 FILETYPE 0x1L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "RetroCRT - real-time CRT filter"
            VALUE "FileVersion", "1.0.0"
            VALUE "InternalName", "RetroCRT"
            VALUE "OriginalFilename", "RetroCRT.exe"
            VALUE "ProductName", "RetroCRT"
            VALUE "ProductVersion", "1.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
